{
  "$schema": "https://raw.githubusercontent.com/KStocky/HLSL-LSP/main/schemas/v1/shadertoolsconfig.schema.json",
  "root": true,
  "hlsl.dxcRuntimeDirectory": "out\\dxc\\runtime",
  "hlsl.languageVersion": "202x",
  "hlsl.targetProfile": "lib_6_6",
  "hlsl.virtualDirectoryMappings": {
    "/Tests": "shader",
    "/Test": "dependencies\\stf\\src\\Shader"
  },
  "hlsl.preprocessorDefinitions": {
    "STF_ASSERTION_LIBRARY": "\"/Test/STF/AssertionsV1/Framework.hlsli\"",
    "TYPE_ID_UNDEFINED": 0,
    "READER_ID_PER_THREAD_SCRATCH": 1,
    "READER_ID_FUNDAMENTAL": 2,
    "TTL_STRING_MAX_LENGTH": 64,
    "TTL_ENABLE_STRINGS": 0
  },
  "hlsl.additionalArguments": [
    "-enable-16bit-types",
    "-Wno-c++14-extensions",
    "-Wno-c++1z-extensions"
  ],
  "hlsl.fileGroups": [
    {
      "name": "VectorInit shader test",
      "files": ["shader\\VectorInit.hlsl"],
      "hlsl.targetProfile": "cs_6_6",
      "hlsl.entryPoint": "VectorInit"
    }
  ]
}
